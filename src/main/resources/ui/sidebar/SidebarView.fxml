<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="sidebar" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.ntnu.idi.idatt2003.ui.sidebar.SidebarController"
      prefWidth="250"
      maxWidth="250"
      maxHeight="Infinity"
      translateX="-250"
      StackPane.alignment="CENTER_LEFT"
      style="-fx-background-color: #2c3e50;">

    <Label text="Navigation" style="-fx-text-fill: white;"/>

    <Button text="Stocks" onAction="#onStocks"/>
    <Button text="Portfolio" onAction="#onPortfolio"/>
    <Button text="Settings" onAction="#onSettings"/>

</VBox>